# Dependencies (Bun is the only package manager; other lockfiles are refused)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output and generated types
dist/
.astro/
tsconfig.tsbuildinfo

# Cloudflare / Wrangler local state and secrets
.wrangler/
.dev.vars
.env
.env.*

# Void: generated Cloudflare config and codegen (void.config.ts and
# void.lock.json are the committed sources).
.void-wrangler.jsonc
.void/

# Logs, coverage, editors and OS
*.log
coverage/
.vitest/
.vscode/*
!.vscode/extensions.json
.idea/
.zcode/
.DS_Store
*.sw?
