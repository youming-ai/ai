{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "News Desk template design tokens — names align with tailwind.config.js and src/index.css. Import into Figma Variables with modes: dark, light.",
  "color": {
    "night": {
      "$type": "color",
      "$description": "Tailwind: night / CSS: --c-bg",
      "$value": {
        "dark": "#0c0c12",
        "light": "#f5f6fb"
      }
    },
    "panel": {
      "$type": "color",
      "$description": "Tailwind: panel / CSS: --c-surface",
      "$value": {
        "dark": "#1f1e2a",
        "light": "#ffffff"
      }
    },
    "panel2": {
      "$type": "color",
      "$description": "Tailwind: panel2 / CSS: --c-surface2",
      "$value": {
        "dark": "#2f2f40",
        "light": "#ebebf5"
      }
    },
    "line": {
      "$type": "color",
      "$description": "Tailwind: line / CSS: --c-line",
      "$value": {
        "dark": "#393950",
        "light": "#cdcedd"
      }
    },
    "chalk": {
      "$type": "color",
      "$description": "Tailwind: chalk / CSS: --c-text",
      "$value": {
        "dark": "#f5f5fd",
        "light": "#151420"
      }
    },
    "chalkdim": {
      "$type": "color",
      "$description": "Tailwind: chalkdim / CSS: --c-muted",
      "$value": {
        "dark": "#9191a3",
        "light": "#626378"
      }
    },
    "pitch": {
      "$type": "color",
      "$description": "Tailwind: pitch / CSS: --c-pitch — brand accent, the brand violet. Light is the brand colour itself, #5200ff: 6.9:1 on the page ground, 7.3:1 on cards, 5.2:1 on the 15% rail-row fill. On the dark ground #5200ff is only ~2.6:1, so dark uses it mixed 1:1 with white, #a980ff: 6.7 / 6.0 / 5.5:1. White on a #5200ff fill is 7.5:1.",
      "$value": {
        "dark": "#a980ff",
        "light": "#5200ff"
      }
    },
    "live": {
      "$type": "color",
      "$description": "Tailwind: live / CSS: --c-live — broadcast live state. Light #c62b26 clears AA (4.5:1) on the page ground.",
      "$value": {
        "dark": "#ff453a",
        "light": "#c62b26"
      }
    },
    "amber": {
      "$type": "color",
      "$description": "Tailwind: amber / CSS: --c-amber — halftime / paused. Light value darkened for AA on white (5.05:1).",
      "$value": {
        "dark": "#fbbf24",
        "light": "#9c6400"
      }
    },
    "overlay": {
      "$type": "color",
      "$description": "Tailwind: overlay — elevation tint. Use overlay/5, overlay/10 for glass controls.",
      "$value": {
        "dark": "#ffffff",
        "light": "#000000"
      }
    }
  },
  "radius": {
    "micro": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Tailwind: rounded-micro / Thumbnails, badges. Flattened to 0 — square UI."
    },
    "card-inset": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Tailwind: rounded-card-inset / Images inside cards. Flattened to 0 — square UI."
    },
    "card": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Tailwind: rounded-card / Cards, tables, lists. Flattened to 0 — square UI."
    },
    "control": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Tailwind: rounded-control / Buttons, tabs, chips. Flattened to 0 — square UI."
    },
    "panel": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Tailwind: rounded-panel / Header dropdowns, floating panels. Flattened to 0 — square UI."
    },
    "hero": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Tailwind: rounded-hero / Hero scoreboard, focal surfaces. Flattened to 0 — square UI."
    },
    "pill": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "Tailwind: rounded-pill / Segmented controls, chips. Flattened to 0 — square UI."
    }
  },
  "spacing": {
    "page-x": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Tailwind: px-page-x"
    },
    "page-x-md": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Tailwind: md:px-page-x-md"
    },
    "page-y": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Tailwind: py-page-y"
    },
    "page-y-md": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Tailwind: md:py-page-y-md"
    },
    "section": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Tailwind: space-y-section"
    },
    "stack": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Tailwind: gap-stack"
    },
    "card": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Tailwind: p-card, gap-card"
    },
    "card-inner": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Tailwind: gap-card-inner"
    }
  },
  "typography": {
    "micro": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Tailwind: text-micro / ds-micro — meta and timestamp line"
    },
    "caption": {
      "$type": "dimension",
      "$value": "11px",
      "$description": "Tailwind: text-caption / ds-caption — broadcast labels"
    },
    "label": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Tailwind: text-label"
    },
    "body": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Tailwind: text-body / ds-body — card body copy"
    },
    "lead": {
      "$type": "dimension",
      "$value": "18px",
      "$description": "Tailwind: text-lead / ds-lead — hero descriptions"
    },
    "hero": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Tailwind: text-hero / ds-hero — page titles"
    },
    "font-display": {
      "$type": "fontFamily",
      "$value": "Archivo"
    },
    "font-body": {
      "$type": "fontFamily",
      "$value": "Inter"
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace"
    }
  },
  "shadow": {
    "panel": {
      "$type": "shadow",
      "$description": "Tailwind: shadow-panel — cards, tables",
      "$value": {
        "dark": "0 4px 6px -1px rgba(0,0,0,0.25), 0 2px 4px -2px rgba(0,0,0,0.2)",
        "light": "0 2px 6px -1px rgba(0,0,0,0.1), 0 1px 3px -1px rgba(0,0,0,0.07)"
      }
    },
    "hero": {
      "$type": "shadow",
      "$description": "Tailwind: shadow-hero — match detail hero",
      "$value": {
        "dark": "0 10px 15px -3px rgba(0,0,0,0.3), 0 4px 6px -4px rgba(0,0,0,0.2)",
        "light": "0 8px 12px -3px rgba(0,0,0,0.1), 0 4px 6px -4px rgba(0,0,0,0.08)"
      }
    },
    "float": {
      "$type": "shadow",
      "$description": "Tailwind: shadow-float — dropdowns",
      "$value": {
        "dark": "0 20px 25px -5px rgba(0,0,0,0.35), 0 8px 10px -6px rgba(0,0,0,0.2)",
        "light": "0 16px 20px -5px rgba(0,0,0,0.12), 0 8px 10px -6px rgba(0,0,0,0.08)"
      }
    }
  },
  "component": {
    "ds-segmented": {
      "$description": "Capsule track — bg-panel/60 border-line/20 rounded-pill"
    },
    "ds-card": {
      "$description": "Story card — skips off-screen layout and paint (content-visibility)"
    },
    "ds-caption": {
      "$description": "Mono caption — font-mono text-caption"
    },
    "ds-micro": {
      "$description": "Mono micro — font-mono text-micro"
    }
  },
  "alpha": {
    "overlay-5": {
      "$type": "number",
      "$value": 0.05,
      "$description": "bg-overlay/5 — segmented track"
    },
    "overlay-10": {
      "$type": "number",
      "$value": 0.1,
      "$description": "bg-overlay/10 — active tab/chip"
    },
    "line-30": {
      "$type": "number",
      "$value": 0.3,
      "$description": "border-line/30 — glass borders"
    }
  }
}
