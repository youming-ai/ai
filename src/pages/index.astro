---
import BoardPage from '../components/explore/BoardPage.astro';
import { SITE_DESCRIPTION, SITE_NAME, SITE_ORIGIN, SITE_TITLE } from '../site';
import Layout from '../layouts/Layout.astro';

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  alternateName: SITE_TITLE,
  url: SITE_ORIGIN,
  description: SITE_DESCRIPTION,
};
---
<Layout title={SITE_TITLE}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <BoardPage title={SITE_TITLE} />
  <!-- Keep route entries so the build's downloaded-JS budget can trace the shared board chunk. -->
  <script>
    import '../scripts/board';
  </script>
</Layout>
