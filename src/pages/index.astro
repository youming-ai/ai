---
import { env } from 'cloudflare:workers';
import ExploreView from '../components/explore/ExploreView';
import { getExploreFeed, getExploreFilters } from '../data/api';
import { SITE_DESCRIPTION, SITE_NAME, SITE_ORIGIN, SITE_TITLE } from '../site';
import Layout from '../layouts/Layout.astro';

const ctx = Astro.locals.cfContext;
const [initialData, initialFilters] = await Promise.all([
  getExploreFeed({}, env, ctx),
  getExploreFilters(env, ctx),
]);
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  alternateName: SITE_TITLE,
  url: SITE_ORIGIN,
  description: SITE_DESCRIPTION,
};
---
<Layout title={SITE_TITLE}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <a
    href="#explore-results"
    class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-control focus:bg-panel focus:px-3 focus:py-2 ds-caption"
  >
    Skip to links
  </a>
  <main>
    <h1 class="sr-only">{SITE_TITLE}</h1>
    <ExploreView
      initialData={initialData}
      initialFilters={initialFilters}
      client:load
    />
  </main>
</Layout>
