---
import { CATEGORIES } from '../../categories';
import BoardPage from '../../components/explore/BoardPage.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE_NAME, SITE_ORIGIN } from '../../site';

const { category } = Astro.params;
if (!category || !Object.hasOwn(CATEGORIES, category)) {
  return new Response('Not found', { status: 404 });
}
const match = CATEGORIES[category]!;
// Both the <head> autodiscovery link and the strip's "+ feed" CTA point at
// this category's feed.
const feedPath = `/${category}/rss.xml`;
const categoryUrl = `${SITE_ORIGIN}/${category}`;
const description = `Latest ${match.label} links from the curated explore feed.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${match.label} Links`,
    description,
    url: categoryUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: SITE_ORIGIN,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: SITE_ORIGIN,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: match.label,
        item: categoryUrl,
      },
    ],
  },
];
---
<Layout
  title={`${SITE_NAME} — ${match.label} links`}
  description={description}
  feedPath={feedPath}
  feedTitle={`${SITE_NAME} — ${match.label} links`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <BoardPage title={`${SITE_NAME} — ${match.label} links`} category={category} />
  <!-- Keep route entries so the build's downloaded-JS budget can trace the shared board chunk. -->
  <script>
    import '../../scripts/board';
  </script>
</Layout>