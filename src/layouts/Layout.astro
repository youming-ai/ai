---
import '../index.css';
import Footer from '../components/Footer.astro';
import {
  SITE_DESCRIPTION,
  SITE_LANGUAGE,
  SITE_LOCALE,
  SITE_NAME,
  SITE_ORIGIN,
  SITE_TITLE,
} from '../site';

interface Props {
  title?: string;
  description?: string;
  /** RSS surface this page is the web twin of — `/rss.xml` globally,
   *  `/<category>/rss.xml` on a category hub. */
  feedPath?: string;
  feedTitle?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  feedPath = '/rss.xml',
  feedTitle = SITE_TITLE,
} = Astro.props;

/** Every page shares the site card: there are no per-link summary pages any
 *  more, so there is no per-page image to override it with. */
const socialImage = `${SITE_ORIGIN}/og.png`;
const socialImageAlt = `${SITE_NAME}: curated links from across the web`;
const socialCard = 'summary_large_image';

// Strip a trailing slash from the path so canonical/og:url match the actual page.
const rawPath = Astro.url.pathname;
const canonicalPath =
  rawPath.length > 1 && rawPath.endsWith('/') ? rawPath.slice(0, -1) : rawPath || '/';
const canonicalUrl = `${SITE_ORIGIN}${canonicalPath}`;
---
<!doctype html>
<html lang={SITE_LANGUAGE} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Server-rendered default so the tag is never empty for a crawler or a
        no-JS visitor: it mirrors --c-bg for the default (dark) theme, and the
        inline script below re-syncs it whenever the theme changes. -->
    <meta name="theme-color" content="rgb(10 14 12)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={feedTitle}
      href={`${SITE_ORIGIN}${feedPath}`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:image" content={socialImage} />
    {socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content={socialCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
    <!-- Fonts are self-hosted now (see the @font-face block in index.css):
         three latin-subset variable files served from this origin, so there is
         no third-party stylesheet on the critical path and no preconnect to a
         host the reader would otherwise never contact. Archivo carries the desk
         headlines, Inter keeps prose readable, JetBrains Mono labels live state
         and source metadata.
         Deliberately NOT preloaded: measuring with and without showed the
         preloads put ~83KB on the critical path and cost ~180ms of FCP, while
         `font-display: swap` already paints text immediately in the fallback. -->
    <!-- TODO(template): add your analytics (e.g. Clarity/Plausible) here -->
    <!-- Read the stored theme before first paint so the first frame already
        carries the right chrome; keep meta theme-color in sync with --c-bg so
        the mobile browser chrome follows the switch. -->
    <script is:inline>
      (() => {
        // Read the stored value first: the stylesheet may not have resolved yet
        // when this inline script runs (Astro injects <link> last in <head>),
        // and getComputedStyle would then return '' for --c-bg.
        const choice = (() => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        })();
        const theme = choice === 'light' ? 'light' : 'dark';
        const candidates = { dark: 'rgb(10 14 12)', light: 'rgb(244 247 245)' };
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', candidates[theme]);
        const syncThemeColor = () => {
          const channels = getComputedStyle(document.documentElement)
            .getPropertyValue('--c-bg')
            .trim();
          if (channels) {
            document
              .querySelector('meta[name="theme-color"]')
              ?.setAttribute('content', `rgb(${channels})`);
          }
        };
        syncThemeColor();
        new MutationObserver(syncThemeColor).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <div class="relative z-10 flex flex-col min-h-screen">
      <div class="flex-1 w-full">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>
