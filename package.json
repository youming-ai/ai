{
  "name": "ai-desk",
  "private": true,
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.4.2"
  },
  "version": "0.1.0",
  "description": "Curated explore feed template — Cloudflare Workers + D1 + KV + Astro",
  "repository": "github:youming-ai/ai",
  "keywords": [
    "cloudflare",
    "astro",
    "news",
    "explore",
    "rss",
    "template"
  ],
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc -p tsconfig.worker.json && astro build && node scripts/perf-budget.mjs",
    "deploy": "bunx wrangler d1 migrations apply DB --remote && bunx wrangler deploy",
    "db:migrate": "bunx wrangler d1 migrations apply DB --remote",
    "typecheck": "astro check && tsc -p tsconfig.worker.json",
    "preview": "astro preview",
    "test": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "perf:seed": "./scripts/prep-local-board.sh",
    "perf:budget": "node scripts/perf-budget.mjs",
    "perf:images": "bun scripts/perf-image-audit.ts",
    "perf:transforms": "bun scripts/perf-image-transform-probe.ts",
    "perf:probe": "node scripts/perf-probe.mjs --url http://127.0.0.1:8787/",
    "feeds:probe": "bun scripts/feed-probe.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "latest",
    "astro": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@biomejs/biome": "latest",
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/dom": "latest",
    "@types/node": "latest",
    "jsdom": "latest",
    "tailwindcss": "latest",
    "typescript": "^6.0.3",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
