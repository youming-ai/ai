{
  "name": "umuo",
  "private": true,
  "engines": {
    "node": ">=22.13",
    "bun": ">=1.4.2"
  },
  "version": "0.1.0",
  "description": "Curated explore feed template — Cloudflare Workers + D1 + KV + Astro",
  "repository": "github:youming-ai/umuo",
  "keywords": [
    "cloudflare",
    "astro",
    "news",
    "explore",
    "rss",
    "template"
  ],
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc -p tsconfig.worker.json && astro build && node scripts/perf-budget.mjs",
    "deploy": "bunx wrangler d1 migrations apply DB --remote && bunx wrangler deploy",
    "db:migrate": "bunx wrangler d1 migrations apply DB --remote",
    "typecheck": "astro check && tsc -p tsconfig.worker.json",
    "preview": "astro preview",
    "test": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "perf:seed": "./scripts/prep-local-board.sh",
    "perf:budget": "node scripts/perf-budget.mjs",
    "perf:probe": "node scripts/perf-probe.mjs --url http://127.0.0.1:8787/"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.4",
    "@astrojs/react": "^6.0.4",
    "astro": "^7.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^23.2.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
